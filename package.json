{
  "name": "grugbrain",
  "version": "2.16.0",
  "description": "Grug make Claude use few token. Zero-touch token saver + self-maintaining memory graph for Claude Code & Claude Desktop: API proxy with prompt-cache autopilot, tool-output trimming, read guard, repo maps, code outlines, Obsidian vault, TUI dashboard.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "grugbrain": "dist/cli.js",
    "grug": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsup",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swaraj792725/grugbrain.git"
  },
  "homepage": "https://github.com/swaraj792725/grugbrain#readme",
  "bugs": "https://github.com/swaraj792725/grugbrain/issues",
  "keywords": [
    "claude",
    "claude-code",
    "claude-desktop",
    "anthropic",
    "mcp",
    "mcp-server",
    "token-saver",
    "prompt-caching",
    "memory",
    "knowledge-graph",
    "obsidian",
    "caveman",
    "grug",
    "llm-cost"
  ],
  "author": "swaraj792725",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "dependencies": {}
}
